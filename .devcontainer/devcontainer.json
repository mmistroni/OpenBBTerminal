{
    "name": "OpenBB Dev Container - Clean Environment",
    
    // --- BUILD CONFIGURATION ---
    "build": {
        "dockerfile": "../build/docker/platform.dockerfile", 
        "context": ".."
    },

    "remoteUser": "root",
    
    // --- CRITICAL SECTION: containerEnv ---
    // Maps individual Codespace Secrets (right side) to individual 
    // environment variables (left side) that are instantly available 
    // in the container's environment (terminal and application).
    "containerEnv": {
        // Map your application's expected variable name to your Codespace Secret name:
        "fmp_api_key": "${localEnv:FMP_API_KEY}",
        "benzinga_api_key": "${localEnv:BENZINGA_API_KEY}",
        "fred_api_key": "${localEnv:FRED_API_KEY}",
        // Add all your other individual API keys here...
        "intrinio_api_key":"${localEnv:INTRINIO_API_KEY}",
        "polygon_api_key":"${localEnv:POLYGON_API_KEY}",
        "trading_economics_api_key":"${localEnv:TRADING_ECONOMICS_API_KEY}",
        "api_key_intrinio":"${localEnv:API_KEY_INTRINIO}",
        "api_key_nasdaq":"${localEnv:API_KEY_NASDAQ}",
        "openai_api_key":"${localEnv:OPENAI_API_KEY}",

        // Other critical variables (if stored as secrets):
        "GIT_USER_NAME": "${localEnv:GIT_USER_NAME}",
        "GIT_USER_EMAIL": "${localEnv:GIT_USER_EMAIL}"
    },
    
    // --- POST CREATE COMMAND (Simplified: No Python script needed) ---
    "postCreateCommand": "apt-get update && apt-get install -y git gnupg",

    // --- POST START COMMAND (Simplified: Just Git config now) ---
    // Variables like $GIT_USER_NAME are now available instantly from containerEnv
    "postStartCommand": "git config --global user.name \"$GIT_USER_NAME\" && git config --global user.email \"$GIT_USER_EMAIL\" && git config  commit.gpgsign false",

    // --- initializeCommand is REMOVED as shell sourcing is no longer needed ---

    // --- VS Code Extensions and Settings ---
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.testing.pytestEnabled": true
            },
            "extensions": [
                "ms-python.python", 
                "ms-python.vscode-pylance",
                "ms-azuretools.vscode-docker",
                "EditorConfig.EditorConfig"
            ]
        }
    },
    
    "forwardPorts": [8000]
}