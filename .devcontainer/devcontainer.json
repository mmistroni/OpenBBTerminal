{
    "name": "OpenBB Dev Container - Optimized",
    
    // Use the Dockerfile from the root to build the environment
    "build": {
        // --- THIS IS THE CRITICAL CHANGE ---
        // Move UP (../) from .devcontainer/, then DOWN to the file
        "dockerfile": "../build/docker/platform.dockerfile", 
        // The context is still ".." (the repo root), which is correct.
        "context": ".."
    },

    "remoteUser": "root",
    
    // CRUCIAL: Remove the slow commands entirely or leave empty.
    // The environment is now fully ready, dramatically reducing startup time.
    "postCreateCommand": [
            "apt-get update && apt-get install -y git && git config --global user.name \"mmistroni\" && git config --global user.email \"mmistroni@gmail.com\"  && poetry install", 
            "chmod +x .devcontainer/env_setup.sh",
            // 2. Run the script once to *CREATE* the environment file (.codespace_env)
            ".devcontainer/env_setup.sh"

    ],

    // Command that runs EVERY TIME the Codespace starts/resumes
    // This adds a 'source' command to the .bashrc file, guaranteeing the variables load.
    "postStartCommand": "echo 'source /workspaces/OpenBBTerminal/.codespace_env' >> ~/.bashrc",
    // --- VS Code Extensions (Highly Recommended) ---
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.testing.pytestEnabled": true,
                // --- ADD THESE GIT SETTINGS ---
                
                
            },
            "extensions": [
                "ms-python.python", 
                "ms-python.vscode-pylance",
                "ms-azuretools.vscode-docker",
                "EditorConfig.EditorConfig"
            ]
        }
    },
    
    "forwardPorts": [8000]
}
