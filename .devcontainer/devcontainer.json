{
    "name": "OpenBB Dev Container - Optimized",
    
    // Use the Dockerfile from the root to build the environment
    "build": {
        "dockerfile": "build/docker/platform.dockerfile", 
        "context": ".."
        // NOTE: Changed from "Dockerfile" to "../Dockerfile" because 
        // the devcontainer is in a subdirectory and the Dockerfile is in the root.
    },

    "remoteUser": "root",
    
    // CRUCIAL: Remove the slow commands entirely or leave empty.
    // The environment is now fully ready, dramatically reducing startup time.
    "postCreateCommand": "", 

    // --- VS Code Extensions (Highly Recommended) ---
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.testing.pytestEnabled": true
            },
            "extensions": [
                "ms-python.python", 
                "ms-python.vscode-pylance",
                "ms-azuretools.vscode-docker",
                "EditorConfig.EditorConfig"
            ]
        }
    },
    
    "forwardPorts": [8000]
}
