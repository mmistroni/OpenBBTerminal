{
"name": "OpenBB Platform Venv Dev Environment",
"build": {
"dockerfile": "Dockerfile"
},
"customizations": {
"vscode": {
"extensions": [
"ms-python.python",
"ms-python.vscode-pylance",
"EditorConfig.EditorConfig"
],
"settings": {
"python.defaultInterpreterPath": "${workspaceFolder}/openbb_platform/.venv/bin/python"
}
}
},
"remoteUser": "root",
"containerEnv": {
"POETRY_VIRTUALENVS_IN_PROJECT": "true"
},
// In .devcontainer/devcontainer.json
"postCreateCommand": "/bin/bash .devcontainer/post_create_setup.sh"
}